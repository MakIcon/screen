{
  "productName": "ScreenLauncher",
  "version": "0.2.4",
  "identifier": "com.makar.screen",
  "build": {
    "beforeDevCommand": "pnpm icons && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/build_installer_skin.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenLauncher",
        "width": 20,
        "height": 4,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/branding.nsh",
        "template": "nsis/installer.nsi",
        "languages": ["Russian"]
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3N0VCMjg5NkMxRkM3MjgKUldRb3h4OXNpYkorUjkrRlVVMExWa0M3Mys2Yi9NR25SOVhaV3ZGQVp6Tkc2RU9sWkZzbTlNUlUK",
      "endpoints": [
        "https://gist.githubusercontent.com/MakIcon/7f89bdec5673899ca35511d92c58794a/raw/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
