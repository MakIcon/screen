{
  "name": "screen",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm build:pathfinder && pnpm catalog && pnpm icons && pnpm typecheck && vite build",
    "build:pathfinder": "pnpm --filter @screenlauncher/mineflayer-bot build:pathfinder",
    "test:pathfinder": "pnpm --filter @screenlauncher/minecraft-pathfinding test",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/generate_app_icons.mjs",
    "catalog": "node scripts/generate_minecraft_catalog.mjs",
    "check": "pnpm typecheck && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "pnpm lint:i18n && vitest run src",
    "test:worker": "pnpm --filter @screenlauncher/mineflayer-bot test",
    "test:release": "node --test scripts/launcher_release_github.test.mjs",
    "release": "node scripts/release_launcher.mjs",
    "package:extensions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_optional_extensions.ps1",
    "lint:i18n": "node scripts/check_localization.mjs",
    "test:i18n": "vitest run src/i18n src/appearance/localization.test.ts src/utils/errors.test.ts src/utils/installProgress.test.ts && node --test scripts/check_localization.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@ybouane/liquidglass": "^1.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
